# Copy to .env to override defaults
DB_DIALECT=sqlite
DATABASE_URL=sqlite:///./data/polymarket_demo.db

# For TimescaleDB (production), use:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://pm:pm@localhost:5432/polymarket

GAMMA_BASE=https://gamma-api.polymarket.com
CLOB_BASE=https://clob.polymarket.com
INGESTOR_MODE=live
LIVE_POLL_INTERVAL_S=60
LIVE_LIMIT=50
LOG_LEVEL=INFO
